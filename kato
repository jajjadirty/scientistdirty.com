<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Serverless Chat (4 months retention)</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 0; padding: 0; display: flex; height: 100vh; }
    .container { width: 100%; max-width: 800px; margin: auto; padding: 20px; }
    #loginScreen, #chatScreen { display: none; }
    .card { border: 1px solid #ddd; border-radius: 8px; padding: 16px; background: #fff; }
    #messages { height: 60vh; overflow-y: auto; border: 1px solid #eee; padding: 8px; background: #f9f9f9; }
    .message { padding: 6px 8px; border-radius: 6px; margin: 6px 0; background: #fff; }
    .meta { font-size: 0.8em; color: #666; }
    .me { background: #dcf8c6; align-self: flex-end; }
    .inputRow { display: flex; gap: 8px; margin-top: 8px; }
    input, textarea { padding: 8px; border: 1px solid #ccc; border-radius: 6px; width: 100%; }
    button { padding: 8px 12px; border-radius: 6px; border: 0; background: #4a90e2; color: white; cursor: pointer; }
    button.secondary { background: #eee; color: #333; }
  </style>
</head>
<body>
  <div class="container">
    <!-- Login Screen -->
    <section id="loginScreen" class="card">
      <h2>Login</h2>
      <p>Enter the login key to access the chat room.</p>
      <input id="passwordInput" type="password" placeholder="Login key (default: king)" />
      <div style="margin-top:8px; display:flex; gap:8px;">
        <button id="loginBtn">Enter Chat</button>
        <button id="quickKey" class="secondary" title="Use default key 'king'">Use default key</button>
      </div>
      <p style="margin-top:8px; font-size:12px; color:#666;">Note: This is a client-side demo. Data stays in your browser.</p>
    </section>

    <!-- Chat Screen -->
    <section id="chatScreen" class="card" aria-label="Chat room">
      <div style="display:flex; justify-content: space-between; align-items:center; margin-bottom:8px;">
        <strong>Chat Room (4 months retention, client-side)</strong>
      </div>

      <div id="messages"></div>

      <div class="inputRow">
        <input id="nameInput" placeholder="Your name (optional)" />
      </div>
      <div class="inputRow" style="margin-top:6px;">
        <input id="messageInput" placeholder="Type a message..." />
        <button id="sendBtn" title="Send">Send</button>
      </div>
    </section>
  </div>

  <script>
    const LOGIN_KEY = 'king'; // default login key
    const STORAGE = {
      MESSAGES: 'chatMessages',
      STATE: 'chatState'
    };

    const loginScreen = document.getElementById('loginScreen');
    const chatScreen = document.getElementById('chatScreen');
    const loginBtn = document.getElementById('loginBtn');
    const quickKey = document.getElementById('quickKey');
    const passwordInput = document.getElementById('passwordInput');
    const messagesDiv = document.getElementById('messages');
    const sendBtn = document.getElementById('sendBtn');
    const messageInput = document.getElementById('messageInput');
    const nameInput = document.getElementById('nameInput');
    const clearBtn = document.getElementById('clearBtn');

    // Helpers
    function loadMessages() {
      const raw = localStorage.getItem(STORAGE.MESSAGES);
      try { return raw ? JSON.parse(raw) : []; } catch { return []; }
    }
    function saveMessages(arr) {
      localStorage.setItem(STORAGE.MESSAGES, JSON.stringify(arr));
    }
    function renderMessages() {
      const msgs = loadMessages().sort((a,b)=> a.timestamp - b.timestamp);
      messagesDiv.innerHTML = '';
      for (const m of msgs) {
        const div = document.createElement('div');
        div.className = 'message';
        div.innerHTML = `<div class="meta">${new Date(m.timestamp).toLocaleString()} - ${m.username || 'Guest'}</div>
                         <div>${escapeHtml(m.text)}</div>`;
        messagesDiv.appendChild(div);
      }
      messagesDiv.scrollTop = messagesDiv.scrollHeight;
    }
    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, m => ({
        '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
      }[m]));
    }
    function pruneOldMessages() {
      const cutoff = Date.now() - 120 * 24 * 60 * 60 * 1000; // 120 days
      const arr = loadMessages().filter(m => m.timestamp >= cutoff);
      saveMessages(arr);
    }

    // State check
    function showChatIfAuthorized() {
      const state = localStorage.getItem(STORAGE.STATE);
      if (state === 'authorized') {
        loginScreen.style.display = 'none';
        chatScreen.style.display = 'block';
        // ensure at least one message renders
        renderMessages();
      } else {
        loginScreen.style.display = 'block';
        chatScreen.style.display = 'none';
      }
    }

    // Init
    document.addEventListener('DOMContentLoaded', () => {
      pruneOldMessages();
      showChatIfAuthorized();
    });

    // Login flow
    loginBtn.addEventListener('click', () => {
      const key = passwordInput.value;
      if (key === LOGIN_KEY) {
        localStorage.setItem(STORAGE.STATE, 'authorized');
        showChatIfAuthorized();
        // optional: save a system message
        addSystemMessage('User logged in');
      } else {
        alert('Incorrect login key.');
      }
    });

    quickKey.addEventListener('click', () => {
      passwordInput.value = LOGIN_KEY;
    });

    // Chat actions
    function addSystemMessage(text) {
      const msgs = loadMessages();
      msgs.push({ id: Date.now(), username: 'System', text, timestamp: Date.now() });
      saveMessages(msgs);
      renderMessages();
    }

    function postMessage() {
      const text = messageInput.value.trim();
      const user = (nameInput.value.trim() || 'Guest');
      if (!text) return;
      const msgs = loadMessages();
      msgs.push({ id: Date.now(), username: user, text, timestamp: Date.now() });
      saveMessages(msgs);
      messageInput.value = '';
      renderMessages();
    }

    sendBtn.addEventListener('click', postMessage);
    messageInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') postMessage();
    });

    clearBtn.addEventListener('click', () => {
      if (confirm('Clear all chat history?')) {
        localStorage.removeItem(STORAGE.MESSAGES);
        renderMessages();
      }
    });
  </script>
</body>
</html>
